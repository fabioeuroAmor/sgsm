# ==============================================================================
# sgsm — variaveis de ambiente por profile (dev / hom / prd)
# Copie para .env e preencha com valores reais. NUNCA commitar o .env real.
# ==============================================================================

# ------------------------------------------------------------------------------
# DEV — hoje sao valores fixos em application-dev.yaml, nao ${VAR}.
# Sobrescrevem o yaml se definidos (Spring aplica env var antes do arquivo),
# usando os nomes padrao de relaxed binding do Spring Boot.
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres?stringtype=unspecified
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
JWT_SECRET=sgsm-chave-desenvolvimento-local-minimo-256-bits-nao-usar-em-producao
# cpf-key/cpf-hmac-key em dev sao literais (nao ${}) - para sobrescrever em dev,
# o nome via relaxed binding e SGSM_CRYPTO_CPF_KEY / SGSM_CRYPTO_CPF_HMAC_KEY,
# NAO os mesmos nomes usados em hom/prd (ver abaixo). Vale alinhar futuramente.
SGSM_CRYPTO_CPF_KEY=ngKlS3LNRsDEW0jmZqYtWD/Rh2jQNIx0AJ/4UsNWUlg=
SGSM_CRYPTO_CPF_HMAC_KEY=vAx0ieowDithdCpiBjJseVKZqv2P2iLxtg+1FC4MdZU=
TRACING_SAMPLING_PROBABILITY=1.0
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# ------------------------------------------------------------------------------
# HOM — application-hom.yaml ja usa ${VAR} em todos os campos abaixo.
# Preencha com os valores reais do ambiente de homologacao.
# ------------------------------------------------------------------------------
# DATASOURCE_URL=
# DATASOURCE_USERNAME=
# DATASOURCE_PASSWORD=
# REDIS_HOST=
# REDIS_PORT=6379
# JWT_SECRET=
# CPF_CRYPTO_KEY=
# CPF_HMAC_KEY=
# TRACING_SAMPLING_PROBABILITY=1.0
# ZIPKIN_ENDPOINT=

# ------------------------------------------------------------------------------
# PRD — mesmas variaveis de HOM (nomes identicos), valores de producao.
# Gerar segredos NOVOS - nunca reaproveitar valor de dev/hom.
# ------------------------------------------------------------------------------
# DATASOURCE_URL=
# DATASOURCE_USERNAME=
# DATASOURCE_PASSWORD=
# REDIS_HOST=
# REDIS_PORT=6379
# JWT_SECRET=
# CPF_CRYPTO_KEY=
# CPF_HMAC_KEY=
# TRACING_SAMPLING_PROBABILITY=0.1
# ZIPKIN_ENDPOINT=
